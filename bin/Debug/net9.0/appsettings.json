{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "UltraGenericSystem.Services.SelfEvolution": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=UltraGenericSystem.db"
  },
  "AzureOpenAI": {
    "Endpoint": "https://tooensure-cursor.openai.azure.com/",
    "ApiKey": "REDACTED",
    "DeploymentName": "gpt-4.1",
    "EmbeddingDeploymentName": "text-embedding-ada-002",
    "MaxTokens": 4000,
    "Temperature": 0.7,
    "TopP": 0.9,
    "FrequencyPenalty": 0.0,
    "PresencePenalty": 0.0,
    "EnableStreaming": true,
    "EnableFunctionCalling": true,
    "EnableVision": false,
    "RetryConfig": {
      "MaxRetries": 3,
      "BaseDelaySeconds": 1,
      "MaxDelaySeconds": 30,
      "UseExponentialBackoff": true
    },
    "MemoryConfig": {
      "EnableMemory": true,
      "MemoryType": "Volatile",
      "MaxMemoryEntries": 1000,
      "MemoryRetentionHours": 24,
      "EnableMemorySearch": true,
      "MemorySearchThreshold": 0.8
    }
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "DefaultModel": "llama3:latest",
    "MaxTokens": 4096,
    "Temperature": 0.7,
    "TopP": 0.9,
    "TopK": 40,
    "RepeatPenalty": 1.1,
    "EnableStreaming": true,
    "EnableFunctionCalling": true,
    "TimeoutSeconds": 120,
    "RetryConfig": {
      "MaxRetries": 3,
      "RetryDelaySeconds": 2,
      "BackoffMultiplier": 2.0
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ultra-generic-system-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AgentOrchestration": {
    "MaxConcurrentOperations": 10,
    "DefaultTimeout": 300,
    "EnableMetrics": true,
    "EnableSelfOptimization": true
  },
  "Database": {
    "EnableDetailedLogging": true,
    "EnableSensitiveDataLogging": false,
    "CommandTimeout": 30
  },
  "API": {
    "EnableSwagger": true,
    "EnableCORS": true,
    "MaxRequestSize": "10MB",
    "RateLimiting": {
      "EnableRateLimiting": true,
      "PermitLimit": 100,
      "Window": "00:01:00"
    }
  },
  "StrangeLoop": {
    "EnableSelfEvolution": true,
    "MaxEvolutionSteps": 10,
    "EvolutionTimeout": "00:10:00",
    "EnableHumanApproval": false,
    "AllowedNamespaces": [
      "UltraGenericSystem.Generated",
      "System.Threading.Tasks",
      "System.Collections.Generic"
    ]
  }
}
