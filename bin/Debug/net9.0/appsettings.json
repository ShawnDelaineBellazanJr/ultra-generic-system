{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=UltraGenericSystem.db"
  },
  "AzureOpenAI": {
    "Endpoint": "https://your-resource.openai.azure.com/",
    "ApiKey": "your-api-key-here",
    "DeploymentName": "gpt-4",
    "TextDeploymentName": "gpt-4"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ultra-generic-system-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AgentOrchestration": {
    "MaxConcurrentOperations": 10,
    "DefaultTimeout": 300,
    "EnableMetrics": true,
    "EnableSelfOptimization": true
  },
  "Database": {
    "EnableDetailedLogging": true,
    "EnableSensitiveDataLogging": false,
    "CommandTimeout": 30
  },
  "API": {
    "EnableSwagger": true,
    "EnableCORS": true,
    "MaxRequestSize": "10MB",
    "RateLimiting": {
      "EnableRateLimiting": true,
      "PermitLimit": 100,
      "Window": "00:01:00"
    }
  }
} 